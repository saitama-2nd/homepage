---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { site } from '../site';
---

<BaseLayout title="スポンサー">
  <PageHero en="SPONSOR" title="スポンサーのご案内" />
  <section class="section">
    <div class="container">
      <ComingSoon message="スポンサー向けのご案内は準備中です。" />
      <div class="btn-row" style="margin-top: 28px; justify-content: center">
        {
          site.sponsorContactUrl ? (
            <a class="btn btn-primary" href={site.sponsorContactUrl} target="_blank" rel="noopener noreferrer">
              スポンサーのお問い合わせ
            </a>
          ) : (
            <span class="btn btn-primary" aria-disabled="true">お問い合わせ（準備中）</span>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
