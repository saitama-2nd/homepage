---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ComingSoon from '../components/ComingSoon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="スポンサー">
  <PageHero en="SPONSOR" title="スポンサーのご案内" />
  <section class="section">
    <div class="container">
      <ComingSoon message="スポンサー向けのご案内は準備中です。" />
      <div class="btn-row" style="margin-top: 28px; justify-content: center">
        <a class="btn btn-primary" href={`${base}/contact/?type=sponsor`}>スポンサーについて問い合わせる</a>
      </div>
    </div>
  </section>
</BaseLayout>
