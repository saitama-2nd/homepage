---
// 試合の日程・結果。data/matches.csv から読み込む。
// 得点が入っていれば「結果」、空なら「日程」として自動で振り分ける。
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { loadMatches, formatDate, todayJst } from '../lib/data';
import { site } from '../site';

const matches = loadMatches();
// 日程：結果が未入力で、今日以降の試合（結果の入れ忘れで日付が過ぎたものは、ここには出さない）
const upcoming = matches.filter((m) => !m.played && m.date >= todayJst());
const isSample = matches.some((m) => m.opponent.includes('サンプル'));
const results = matches.filter((m) => m.played).reverse(); // 新しい順
const label = { win: 'WIN', lose: 'LOSE', draw: 'DRAW' } as const;
const scoreText = (m: (typeof matches)[number]) => {
  if (typeof m.ourScore === 'string') return m.ourScore;
  if (typeof m.theirScore === 'string') return m.theirScore;
  if (m.extraTimeOurScore !== null && m.extraTimeTheirScore !== null) {
    return `${m.extraTimeOurScore} - ${m.extraTimeTheirScore}`;
  }
  return `${m.ourScore} - ${m.theirScore}`;
};
const scoreDetail = (m: (typeof matches)[number]) => {
  if (m.penaltyOurScore !== null && m.penaltyTheirScore !== null) {
    return `PK ${m.penaltyOurScore}-${m.penaltyTheirScore}`;
  }
  if (m.extraTimeOurScore !== null && m.extraTimeTheirScore !== null) {
    return `延長後（90分 ${m.ourScore}-${m.theirScore}）`;
  }
  return '';
};
---

<BaseLayout
  title="試合"
  description="埼玉県のさいたま市南部支部1部リーグ所属、Saitama 2nd.の試合日程・試合結果。リーグ戦などの予定とスコアを掲載します。"
>
  <PageHero en="MATCHES" title="試合日程・結果" />
  <section class="section">
    <div class="container">
      {
        matches.length === 0 ? (
          <div class="card">
            <h2>試合日程は決まり次第掲載します</h2>
            <p>現在掲載できる試合情報はありません。チームの活動についてはInstagramでもご覧いただけます。</p>
            {site.instagramUrl && (
              <a class="btn btn-dark" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
                Instagramを見る
              </a>
            )}
          </div>
        ) : (
          <>
            <div class="section-title"><small>SCHEDULE</small><h2>これからの試合</h2></div>
            <ul class="match-list" style="margin-top: 20px">
              {upcoming.length === 0 && <li class="meta">予定されている試合はありません。</li>}
              {upcoming.map((m) => (
                <li class="match">
                  <div class="date">{formatDate(m.date).md}<small>{formatDate(m.date).week}</small></div>
                  <div>
                    <div class="vs">vs {m.opponent}</div>
                    <div class="meta">{[m.competition, m.venue, m.note].filter(Boolean).join(' / ')}</div>
                  </div>
                  <div class="score"><small>UPCOMING</small>—</div>
                </li>
              ))}
            </ul>

            <div class="section-title" style="margin-top: 56px"><small>RESULTS</small><h2>試合結果</h2></div>
            <ul class="match-list" style="margin-top: 20px">
              {results.length === 0 && <li class="meta">まだ結果はありません。</li>}
              {results.map((m) => (
                <li class={`match ${m.result}`}>
                  <div class="date">{formatDate(m.date).md}<small>{formatDate(m.date).week}</small></div>
                  <div>
                    <div class="vs">vs {m.opponent}</div>
                    <div class="meta">{[m.competition, m.venue, m.note].filter(Boolean).join(' / ')}</div>
                  </div>
                  <div class="score">
                    <small>{label[m.result!]}</small>
                    {scoreText(m)}
                    {scoreDetail(m) && <small class="score-detail">{scoreDetail(m)}</small>}
                  </div>
                </li>
              ))}
            </ul>
            {isSample && <p class="ai-note">※ 現在表示している試合はサンプルです。</p>}
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
