---
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <img src={`${base}/images/emblem.png`} alt="" width="48" height="48" />
        <div>
          <b>{site.teamName}</b><br />
          <span>{site.league}</span>
        </div>
      </div>
      {
        site.instagramUrl && (
          <a
            class="instagram-link"
            href={site.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram公式アカウントを開く"
          >
            <img src={`${base}/images/instagram.svg`} alt="" width="36" height="36" />
          </a>
        )
      }
    </div>
    <small>© {year} {site.teamName}</small>
  </div>
</footer>
