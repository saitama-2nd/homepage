---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ComingSoon from '../components/ComingSoon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="入団・体験"
  description="埼玉県のさいたま市南部支部1部リーグ所属の社会人サッカーチームです。入団や毎週日曜日の練習への体験参加についてお問い合わせください。"
>
  <PageHero en="JOIN US" title="入団・体験のご案内" />
  <section class="section">
    <div class="container">
      <ComingSoon message="入団・体験の案内文（練習日・場所・費用など）は準備中です。" />
      <div class="btn-row" style="margin-top: 28px; justify-content: center">
        <a class="btn btn-primary" href={`${base}/contact/?type=join`}>入団・体験について問い合わせる</a>
      </div>
    </div>
  </section>
</BaseLayout>
