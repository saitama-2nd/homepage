---
// 選手一覧。データは data/players.csv から読み込む。
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { loadPlayers } from '../lib/data';
import { site } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPlayers = loadPlayers();
const isSample = allPlayers.some((p) => p.name.includes('サンプル'));
const players = import.meta.env.DEV
  ? allPlayers
  : allPlayers.filter((p) => !p.name.includes('サンプル'));
---

<BaseLayout
  title="選手"
  description="埼玉県のさいたま市南部支部1部リーグで活動する社会人サッカーチーム、Saitama 2nd.の選手を紹介します。"
>
  <PageHero en="PLAYERS" title="選手紹介" />
  <section class="section">
    <div class="container">
      {
        players.length === 0 ? (
          <>
            <div class="section-title"><small>TEAM</small><h2>20人弱で活動中</h2></div>
            <p class="sub">
              {site.teamName}は、さいたま市南部支部1部リーグで活動する社会人サッカーチームです。
              選手個人のプロフィールは掲載していませんが、新しいメンバーを募集しています。
            </p>
            <div class="btn-row">
              <a class="btn btn-primary" href={`${base}/join/`}>入団・体験について</a>
            </div>
          </>
        ) : (
          <>
            <div class="players">
              {players.map((p) => (
                <article class="player">
                  <img
                    src={p.photo ? `${base}/images/players/${p.photo}` : `${base}/images/player-placeholder.svg`}
                    alt={p.name}
                    loading="lazy"
                  />
                  {p.number && <span class="no">{p.number}</span>}
                  <div class="info">
                    <div class="name">{p.name}</div>
                    <div class="pos">{p.position}</div>
                  </div>
                </article>
              ))}
            </div>
            {import.meta.env.DEV && isSample && <p class="ai-note">※ これは開発用のサンプル選手です。本番サイトには表示されません。</p>}
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
