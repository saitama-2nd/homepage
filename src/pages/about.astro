---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { site } from '../site';
---

<BaseLayout title="チーム紹介">
  <PageHero en="ABOUT US" title="チーム紹介" />
  <section class="section">
    <div class="container">
      <div class="cards">
        <div class="card"><span class="tag">LEAGUE</span><h3>所属リーグ</h3><p>{site.league}</p></div>
        <div class="card"><span class="tag">COLORS</span><h3>チームカラー</h3><p>1st：黄色・紺 ／ 2nd：白・緑</p></div>
      </div>
      <div style="margin-top: 32px">
        <ComingSoon message="チームの紹介文・運営体制は準備中です。" />
      </div>
    </div>
  </section>
</BaseLayout>
