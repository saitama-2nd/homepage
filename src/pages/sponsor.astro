---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="スポンサー"
  description="埼玉県のさいたま市南部支部1部リーグで活動する社会人サッカーチーム、Saitama 2nd.のスポンサー募集案内です。"
>
  <PageHero en="SPONSOR" title="スポンサーのご案内" />
  <section class="section">
    <div class="container">
      <div class="section-title"><small>PARTNER WITH US</small><h2>チームの活動を応援してくださる方へ</h2></div>
      <p class="sub">
        {site.teamName}は、さいたま市南部支部1部リーグで活動する社会人サッカーチームです。
        私たちの活動を応援してくださる企業・店舗・個人の皆さまを募集しています。
      </p>
      <div class="cards">
        <div class="card">
          <span class="tag">SUPPORT</span>
          <h3>チームの挑戦を応援</h3>
          <p>リーグ戦や日々のチーム活動を、スポンサーとして支えていただける方をお待ちしています。</p>
        </div>
        <div class="card">
          <span class="tag">CONSULTATION</span>
          <h3>内容はご相談ください</h3>
          <p>協賛の方法やご希望について、まずはお問い合わせください。内容を伺い、個別にご相談させていただきます。</p>
        </div>
      </div>
      <div class="btn-row" style="margin-top: 28px">
        <a class="btn btn-primary" href={`${base}/contact/?type=sponsor`}>スポンサーについて問い合わせる</a>
      </div>
    </div>
  </section>
</BaseLayout>
